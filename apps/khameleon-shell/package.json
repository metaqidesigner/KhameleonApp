{
  "name": "@khameleon/shell",
  "productName": "Khameleon",
  "version": "0.1.0",
  "description": "Khameleon desktop app",
  "author": "Khameleon",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "pnpm build && electron .",
    "package:mac": "pnpm bundle && pnpm build && electron-builder --mac",
    "package:win": "pnpm bundle && pnpm build && electron-builder --win",
    "bundle": "pnpm --filter @workspace/api-server run build && cd ../../artifacts/khameleon-command && PORT=5199 BASE_PATH=/ pnpm exec vite build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@napi-rs/canvas": "0.1.80",
    "extract-file-icon": "^0.3.2",
    "mammoth": "^1.13.0",
    "node-llama-cpp": "^3.22.1",
    "node-window-manager": "^2.2.4",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@khameleon/integrations": "workspace:*",
    "@types/node": "catalog:",
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "0.27.3",
    "khameleon-file-agent": "workspace:*",
    "khameleon-memory": "workspace:*",
    "khameleon-window-agent": "workspace:*",
    "typescript": "~5.9.3"
  },
  "build": {
    "appId": "com.khameleon.app",
    "productName": "Khameleon",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "asarUnpack": [
      "dist/native/**"
    ],
    "extraResources": [
      {
        "from": "../../THIRD_PARTY_LICENSES.md",
        "to": "THIRD_PARTY_LICENSES.md"
      },
      {
        "from": "build-resources/notices/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      },
      {
        "from": "build-resources/notices/LICENSE.electron.txt",
        "to": "LICENSE.electron.txt"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build-resources/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build-resources/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
