# Copy this file to .env before running `docker compose up` - see SELF_HOSTING.md.
# Both values below are required; docker compose will refuse to start without them
# rather than silently falling back to an insecure default.

# A random secret used to encrypt saved API keys/OAuth tokens/Vault secrets at
# rest (AES-256-GCM - see artifacts/api-server/src/lib/crypto.ts). Generate a
# real one with:
#   openssl rand -base64 32
KHAMELEON_ENCRYPTION_KEY=

# Password for the Postgres database this compose stack creates for you - it
# is never exposed outside the compose network, but still shouldn't be left
# blank or guessable.
POSTGRES_PASSWORD=

# Optional - which host port to reach Khameleon on. Defaults to 4001.
# KHAMELEON_PORT=4001
