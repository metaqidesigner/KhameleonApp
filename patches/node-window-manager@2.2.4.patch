+// Khameleon addition (Cross-App Control Phase 2, khameleon-decisions-log.md,
+// 2026-10-03): real click/type simulation in-process via Quartz Event
+// Services, reusing this addon's own already-Accessibility-trusted
+// identity. Added here (not a separate addon, not a shelled-out osascript
+// call) specifically because osascript turned out to need its own,
+// separately-granted and unreliable Accessibility trust, independent of
+// the calling app's - this runs as Khameleon itself, same trust context
+// getWindowBounds/setWindowBounds already use successfully.
+void _simulateClick(double x, double y) {
+  CGPoint point = CGPointMake(x, y);
+
+  CGEventRef move = CGEventCreateMouseEvent(NULL, kCGEventMouseMoved, point, kCGMouseButtonLeft);
+  CGEventPost(kCGHIDEventTap, move);
+  CFRelease(move);
+
+  CGEventRef down = CGEventCreateMouseEvent(NULL, kCGEventLeftMouseDown, point, kCGMouseButtonLeft);
+  CGEventPost(kCGHIDEventTap, down);
+  CFRelease(down);
+
+  CGEventRef up = CGEventCreateMouseEvent(NULL, kCGEventLeftMouseUp, point, kCGMouseButtonLeft);
+  CGEventPost(kCGHIDEventTap, up);
+  CFRelease(up);
+}
+
+Napi::Boolean simulateClick(const Napi::CallbackInfo &info) {
+  Napi::Env env{info.Env()};
+  auto x = info[0].As<Napi::Number>().DoubleValue();
+  auto y = info[1].As<Napi::Number>().DoubleValue();
+  _simulateClick(x, y);
+  return Napi::Boolean::New(env, true);
+}
+
+// Unicode-string-based key events (not virtual keycodes) so this handles
+// any character the user's keyboard layout can produce, same technique
+// System Events' own "keystroke" uses under the hood.
+void _simulateTypeText(NSString *text) {
+  NSUInteger length = [text length];
+  for (NSUInteger i = 0; i < length; i++) {
+    unichar c = [text characterAtIndex:i];
+
+    CGEventRef keyDown = CGEventCreateKeyboardEvent(NULL, 0, true);
+    CGEventKeyboardSetUnicodeString(keyDown, 1, &c);
+    CGEventPost(kCGHIDEventTap, keyDown);
+    CFRelease(keyDown);
+
+    CGEventRef keyUp = CGEventCreateKeyboardEvent(NULL, 0, false);
+    CGEventKeyboardSetUnicodeString(keyUp, 1, &c);
+    CGEventPost(kCGHIDEventTap, keyUp);
+    CFRelease(keyUp);
+  }
+}
+
+Napi::Boolean simulateTypeText(const Napi::CallbackInfo &info) {
+  Napi::Env env{info.Env()};
+  std::string text = info[0].As<Napi::String>().Utf8Value();
+  NSString *nsText = [NSString stringWithUTF8String:text.c_str()];
+  _simulateTypeText(nsText);
+  return Napi::Boolean::New(env, true);
+}
